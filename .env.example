TELEGRAM_BOT_TOKEN=123456:ABC...
# Nhà cung cấp LLM: anthropic | openai | openai-chat. Model để trống thì dùng mặc định (openai bắt buộc ghi model).
# openai-chat + LLM_BASE_URL: cho dịch vụ tương thích OpenAI (Ollama, vLLM, OpenRouter, ...).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
DB_PATH=data/bot.db
TIMEZONE=Asia/Ho_Chi_Minh
DAILY_SUMMARY_TIME=00:01
COMPACT_THRESHOLD_CHARS=60000
COMPACT_MAX_ATTEMPTS=3
COMPACT_RETRY_DELAY_SECONDS=60
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=
EDITOR_USER_IDS=
# Userbot: tài khoản Telegram của chủ bot, nguồn tin nhắn (đọc được chat riêng, lịch sử cũ, tin lúc bot tắt).
# api_id / api_hash lấy ở https://my.telegram.org (API development tools). USERBOT_SESSION lấy bằng
# python -m bot.userbot_login; session cho toàn quyền vào tài khoản, giữ bí mật. Để trống cả ba thì
# bot tự lưu tin nhóm như trước (chế độ dự phòng).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_SESSION=
# Lần đầu bổ sung tin của một chat thì lấy bấy nhiêu ngày gần nhất
USERBOT_HISTORY_DAYS=7
